{
  "name": "@jsray/core",
  "version": "0.0.2-beta.4",
  "description": "JavaScript-native code rendering kernel with 23-class token semantics and pluggable themes.",
  "author": "Jie <jie@jsray.org>",
  "license": "MIT",
  "homepage": "https://jsray.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsrayorg/jsray.git"
  },
  "bugs": {
    "url": "https://github.com/jsrayorg/jsray/issues"
  },
  "main": "dist/jsray.js",
  "style": "dist/jsray.css",
  "types": "types/jsray.d.ts",
  "exports": {
    ".": {
      "types": "./types/jsray.d.ts",
      "default": "./dist/jsray.js"
    },
    "./dist/*": "./dist/*",
    "./themes/*": "./themes/*",
    "./tokens.json": "./tokens.json",
    "./vocabulary.json": "./vocabulary.json",
    "./integrity.json": "./integrity.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "themes",
    "tokens.json",
    "assets/brand/*.svg",
    "assets/brand/README.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "vocabulary.json",
    "integrity.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "sh build.sh",
    "check:versions": "node tools/check-versions.mjs",
    "check:docs-parity": "node tools/check-docs-parity.mjs",
    "test": "node --test tests/*.mjs",
    "demo": "echo 'Open demo/index.html in a browser, or serve the project root and visit /demo/'",
    "sync:integrations": "sh tools/sync-integrations.sh",
    "check:integrity": "node tools/integrity.mjs --check",
    "release": "sh tools/release.sh",
    "release:dry": "sh tools/release.sh --dry-run"
  },
  "keywords": [
    "jsray",
    "code-rendering",
    "syntax-highlighter",
    "code-highlighter",
    "javascript-native",
    "zero-dependency",
    "developer-tools",
    "themes"
  ],
  "engines": {
    "node": ">=20"
  }
}
